# ==============================================================================
# VEYRA VOICE - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================

# Application Environment (development, testing, production)
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
PROJECT_NAME="Veyra Voice"
API_V1_STR="/api/v1"

# Server Host & Port
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:3002,http://127.0.0.1:3002"

# Security & Authentication
# Generate with: openssl rand -hex 32
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Default to SQLite for zero-config local run, or PostgreSQL for production:
# PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/veyra_voice
DATABASE_URL=sqlite+aiosqlite:///./veyra_voice.db

# Redis / Queue Configuration (optional for local dev, fallback to in-memory)
REDIS_URL=redis://localhost:6379/0

# AI Provider Configuration
# Options: "mock" (default for zero-key dev) or "gemini"
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_MODEL=gemini-3.1-flash-live-preview
GEMINI_VOICE_NAME=Zephyr

# Live Multimodal Voice WebSocket Server (Port 5055 - isolated)
VOICE_SERVER_PORT=5055
NEXT_PUBLIC_VOICE_WS_URL=ws://localhost:5055/api/ws

# Optional Long-Term Memory (Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Telephony Provider Configuration
# Options: "mock" (simulation mode), "twilio" (free trial available), or "exotel"
TELEPHONY_PROVIDER=mock

# Twilio Free Trial Telephony (Instant $15 credit & free phone number from twilio.com/try-twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Exotel Telephony (India/APAC virtual number)
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUB_DOMAIN=api.exotel.com
EXOTEL_CALLER_ID=080XXXXXXXX
EXOTEL_WEBHOOK_SECRET=

# Telephony Webhook Base URL (Public URL or Ngrok tunnel for carrier callbacks & media streams)
TELEPHONY_WEBHOOK_BASE_URL=http://localhost:8000

# Audio & Call Engine Settings
CALL_MAX_DURATION_SECONDS=600
SILENCE_TIMEOUT_SECONDS=10
RECORD_CALLS=false
DEFAULT_PRIMARY_LANGUAGE=en-US
DEFAULT_FALLBACK_LANGUAGE=en-IN
