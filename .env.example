# ==============================================================================
# VEYRA VOICE - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================

# Application Environment (development, testing, production)
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
PROJECT_NAME="Veyra Voice"
API_V1_STR="/api/v1"

# Server Host & Port
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Security & Authentication
# Generate with: openssl rand -hex 32
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Default to SQLite for zero-config local run, or PostgreSQL for production:
# PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/veyra_voice
DATABASE_URL=sqlite+aiosqlite:///./veyra_voice.db

# Redis / Queue Configuration (optional for local dev, fallback to in-memory)
REDIS_URL=redis://localhost:6379/0

# AI Provider Configuration
# Options: "mock" (default for zero-key dev) or "gemini"
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-exp
GEMINI_VOICE_NAME=Aoede

# Telephony Provider Configuration
# Options: "mock" (default for zero-key dev) or "exotel"
TELEPHONY_PROVIDER=mock
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUB_DOMAIN=api.exotel.com
EXOTEL_CALLER_ID=080XXXXXXXX
EXOTEL_WEBHOOK_SECRET=

# Telephony Webhook Base URL (Public URL or Ngrok tunnel for inbound callbacks)
TELEPHONY_WEBHOOK_BASE_URL=http://localhost:8000

# Audio & Call Engine Settings
CALL_MAX_DURATION_SECONDS=600
SILENCE_TIMEOUT_SECONDS=10
RECORD_CALLS=false
DEFAULT_PRIMARY_LANGUAGE=en-US
DEFAULT_FALLBACK_LANGUAGE=en-IN
