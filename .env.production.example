ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS="https://app.veyravoice.com"
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_TO_A_64_CHAR_HEX_KEY
DATABASE_URL=postgresql+asyncpg://postgres:secure_db_password@postgres:5432/veyra_voice
REDIS_URL=redis://redis:6379/0
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash-exp
GEMINI_VOICE_NAME=Aoede
TELEPHONY_PROVIDER=exotel
EXOTEL_ACCOUNT_SID=your_exotel_sid
EXOTEL_API_KEY=your_exotel_key
EXOTEL_API_TOKEN=your_exotel_token
EXOTEL_SUB_DOMAIN=api.exotel.com
EXOTEL_CALLER_ID=+918012345678
EXOTEL_WEBHOOK_SECRET=your_webhook_secret_hmac
TELEPHONY_WEBHOOK_BASE_URL=https://api.veyravoice.com
RECORD_CALLS=false
