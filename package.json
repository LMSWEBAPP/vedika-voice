{
  "name": "veyra-voice",
  "version": "1.0.0",
  "private": true,
  "description": "Veyra Voice - Production-Oriented AI Outbound Voice Calling Platform",
  "scripts": {
    "dev:web": "npm run dev --prefix apps/web",
    "build:web": "npm run build --prefix apps/web",
    "start:web": "npm run start --prefix apps/web",
    "lint:web": "npm run lint --prefix apps/web",
    "voice:server": "node voice-server.js",
    "dev:all": "concurrently -n \"WEB,VOICE\" -c \"cyan,magenta\" \"npm run dev:web\" \"npm run voice:server\""
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "Veyra Voice Engineering",
  "license": "UNLICENSED",
  "dependencies": {
    "@google/genai": "^2.24.0",
    "@upstash/redis": "^1.39.0",
    "dotenv": "^18.0.4",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  }
}
